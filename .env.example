# AI Study Companion Environment Configuration
# PRD Compliance: Separate secrets and configuration from source code.

PORT=4000
AI_PROVIDER=local
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EXECUTION_MODEL=gemini-3.1-pro

# Institutional Email Delivery (Gmail / Custom SMTP)
# For Gmail: Use your Gmail address and a 16-character Google App Password (from myaccount.google.com/apppasswords)
EMAIL_USER=
EMAIL_PASS=
# Optional Custom SMTP (e.g. Brevo, SendGrid, Outlook)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM="AI Study Companion" <no-reply@aistudycompanion.edu>

